LLM_PROVIDER=openai
LOG_LEVEL=debug
AGENT_TYPE=react
AGENT_MAX_ROUNDS=8
AGENT_TOOL_TIMEOUT=15s
MEMORY_PATH=memory
TOOL_RUNTIME_LIMIT=20
COMPACTION_TOOL_RESULT_BUDGET_ENABLED=true
COMPACTION_TOOL_RESULT_BUDGET_MAX_CHARS=12000
COMPACTION_SNIP_ENABLED=true
COMPACTION_SNIP_TRIGGER_RATIO=0.95
COMPACTION_MICROCOMPACT_ENABLED=true
COMPACTION_MICROCOMPACT_TRIGGER_RATIO=0.70
COMPACTION_MICROCOMPACT_MIN_CHARS=12000
COMPACTION_MICROCOMPACT_KEEP_RECENT_TOOL_RESULTS=8
COMPACTION_CONTEXT_COLLAPSE_ENABLED=false
COMPACTION_CONTEXT_COLLAPSE_TRIGGER_RATIO=0.80
COMPACTION_CONTEXT_COLLAPSE_TARGET_RATIO=0.65
COMPACTION_CONTEXT_COLLAPSE_KEEP_RECENT_TURNS=3
COMPACTION_CONTEXT_COLLAPSE_MAX_SEGMENTS=3
COMPACTION_CONTEXT_COLLAPSE_MAX_CONCURRENCY=2
COMPACTION_CONTEXT_COLLAPSE_MIN_SEGMENT_TOKENS=1500
COMPACTION_AUTO_COMPACT_ENABLED=false
MCP_CONFIG_PATH=mcp.yaml
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
