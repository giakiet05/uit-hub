LLM_PROVIDER=openai
LOG_LEVEL=debug
AGENT_TYPE=react
AGENT_MAX_ROUNDS=8
AGENT_TOOL_TIMEOUT=15s
MEMORY_PATH=memory
TOOL_RUNTIME_LIMIT=20
COMPACTION_TOOL_RESULT_BUDGET_ENABLED=true
COMPACTION_TOOL_RESULT_BUDGET_MAX_CHARS=12000
COMPACTION_SNIP_ENABLED=true
COMPACTION_MICROCOMPACT_ENABLED=true
COMPACTION_MICROCOMPACT_MIN_CHARS=12000
COMPACTION_MICROCOMPACT_KEEP_RECENT_TOOL_RESULTS=2
COMPACTION_CONTEXT_COLLAPSE_ENABLED=false
COMPACTION_AUTO_COMPACT_ENABLED=false
MCP_CONFIG_PATH=mcp.yaml
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
